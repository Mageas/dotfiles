{
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "ask": [
      "Skill(implement)",
      "Skill(implement *)",
      "Skill(implement-spec)",
      "Skill(implement-spec *)"
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "tui": "fullscreen",
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/cache-keeper"
  }
}
